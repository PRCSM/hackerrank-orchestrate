# Copy to .env (never commit .env) or export in your shell.
# Without GROQ_API_KEY the agent runs fully deterministic (same as --no-llm).
GROQ_API_KEY=
# Optional overrides (defaults shown)
# GDSE_INTENT_MODEL=openai/gpt-oss-20b
# GDSE_INVESTIGATOR_MODEL=openai/gpt-oss-120b
# GDSE_FALLBACK_MODEL=qwen/qwen3.8-27b
# GDSE_MAX_INVESTIGATIONS=12
# GDSE_RPM=30
# GDSE_TPM=8000
